{
  "import": [
    "@cspell/dict-lorem-ipsum/cspell-ext.json"
  ],
  "caseSensitive": false,
  "dictionaries": [
    "custom-dictionary"
  ],
  "dictionaryDefinitions": [
    {
      "name": "custom-dictionary",
      "path": "./.cspell/custom-dictionary.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/lib/**",
    "**/docs/**",
    "**/vendor/**",
    "**/public/**",
    "**/static/**",
    "**/out/**",
    "**/tmp/**",
    "**/*.d.ts",
    "**/package.json",
    "**/*.md",
    "**/stats.html",
    "eslint.config.mjs",
    ".gitignore",
    ".prettierignore",
    "cspell.json",
    "commitlint.config.js",
    ".cspell"
  ],
  "words": [
    "AUTOINCREMENT",
    "cdylib",
    "combinators",
    "deepseek",
    "duckduckgo",
    "Gridlayout",
    "kimi",
    "moonshot",
    "nativescript",
    "notif",
    "nscalendar",
    "ollama",
    "pxtorem",
    "qwen",
    "rlib",
    "rrule",
    "serde",
    "sqlitedatabase",
    "staticlib",
    "Tauri",
    "tcamp",
    "zhipu",
    "zindex",
    "WechatSogou"
  ]
}
