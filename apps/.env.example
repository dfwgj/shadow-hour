# 应用环境变量配置
# 复制此文件为 .env 并修改为实际值

# 应用版本号 (CI/CD 会自动更新)
APP_VERSION=1.0.0

# 更新检查 API 地址 (你的服务器返回 version.json)
# 格式参考: { "tag_name": "v1.0.1", "version": "1.0.1", "html_url": "下载链接", "body": "更新说明" }
UPDATE_CHECK_URL=https://your-server.com/api/app/version.json

# 下载页面地址 (备用)
DOWNLOAD_URL=https://your-server.com/download
